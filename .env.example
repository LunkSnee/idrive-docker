# idrive-docker settings. Copy to .env (next to compose.yaml) and edit.
# Lines starting with # are optional; uncomment the ones you need.

# Time zone for IDrive's logs and backup schedule (e.g. America/New_York, Europe/Berlin).
TZ=Etc/UTC

# ---------------------------------------------------------------------------
# Automated login (optional). Leave unset to set up by hand with:
#   docker exec -it idrive idrive --account-setting
# Point these at Docker secret files (see the README and the secrets: blocks in
# compose.yaml). They are only file paths, so they are safe to keep here.
# ---------------------------------------------------------------------------
# IDRIVE_ACCOUNT_FILE=/run/secrets/idrive_account
# IDRIVE_PASSWORD_FILE=/run/secrets/idrive_password
# Only if two-factor authentication (authenticator app) is enabled on the account:
# IDRIVE_TOTP_SECRET_FILE=/run/secrets/idrive_totp_secret
# Only if the account uses a private encryption key:
# IDRIVE_ENCRYPTION_KEY_FILE=/run/secrets/idrive_encryption_key

# Plain values also work, but anyone who can run `docker inspect` can read them:
# IDRIVE_ACCOUNT=
# IDRIVE_PASSWORD=
# IDRIVE_TOTP_SECRET=
# IDRIVE_ENCRYPTION_KEY=

# First-time setup of an empty config volume only (ignored once set up):
# Encryption for the new setup: DEFAULT or PRIVATE (PRIVATE needs the key above).
# IDRIVE_ENCRYPTION_TYPE=DEFAULT
# Name of the backup location ("device") in your IDrive account: 1-64 letters, digits, - or _.
# An existing location with this name is reused, otherwise it is created.
# Without it, IDrive's default name is used.
# IDRIVE_BACKUP_LOCATION=my-server

# Seconds between login checks; a logout seen twice in a row restarts the container so it
# logs in again (needs automated login and `restart: unless-stopped`). 0 turns it off.
# IDRIVE_WATCHDOG_INTERVAL=300
